def save_game():
    data = {
        "деньги": деньги, "кирка": кирка, "всего_алмазов": всего_алмазов,
        "рекорд": рекорд, "авто": авто, "помощники": помощники,
        "глубина": глубина, "тариф": тариф, "скорость": скорость,
        "престиж": престиж, "всего_накопал": всего_накопал,
        "звёзды": звёзды,
        "питомцы": питомцы, "боссы_побеждены": боссы_побеждены,
        "оружие": {k: v["куплено"] for k, v in оружие.items()},
        "множители_урона": {k: v["куплено"] for k, v in множители_урона.items()},
        "локация": локация,
        "локации_открыты": {k: v["открыта"] for k, v in локации.items()},
        "секретные_питомцы": {k: v["куплен"] for k, v in секретные_питомцы.items()},
    }
    with open(SAVE_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def load_game():
    global деньги, кирка, всего_алмазов, рекорд, авто, помощники
    global глубина, тариф, скорость, престиж, всего_накопал, питомцы, боссы_побеждены
    global локация, звёзды
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        деньги = data.get("деньги", 0)
        кирка = data.get("кирка", 1)
        всего_алмазов = data.get("всего_алмазов", 0)
        рекорд = data.get("рекорд", 0)
        авто = data.get("авто", False)
        помощники = data.get("помощники", 0)
        глубина = data.get("глубина", 1)
        тариф = data.get("тариф", 0)
        скорость = data.get("скорость", 1)
        престиж = data.get("престиж", 0)
        всего_накопал = data.get("всего_накопал", 0)
        звёзды = data.get("звёзды", 0)
        if "питомцы" in data:
            for имя in питомцы:
                if имя in data["питомцы"]:
                    питомцы[имя]["куплен"] = data["питомцы"][имя].get("куплен", False)
        if "боссы_побеждены" in data:
            боссы_побеждены = data["боссы_побеждены"]
        if "оружие" in data:
            for имя in оружие:
                if имя in data["оружие"]:
                    оружие[имя]["куплено"] = data["оружие"][имя]
        if "множители_урона" in data:
            for имя in множители_урона:
                if имя in data["множители_урона"]:
                    множители_урона[имя]["куплено"] = data["множители_урона"][имя]
        if "локация" in data:
            локация = data["локация"]
        if "локации_открыты" in data:
            for имя in локации:
                if имя in data["локации_открыты"]:
                    локации[имя]["открыта"] = data["локации_открыты"][имя]
        if "секретные_питомцы" in data:
            for имя in секретные_питомцы:
                if имя in data["секретные_питомцы"]:
                    секретные_питомцы[имя]["куплен"] = data["секретные_питомцы"][имя]
    except:
        pass

