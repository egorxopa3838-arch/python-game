            print(f"{i}. {имя}: ×{м['множитель']} урона — {статус}")
        print("0 - Назад")
        try:
            выбор = int(input("Что купить? "))
            if выбор == 0:
                pass
            elif 1 <= выбор <= len(список_множителей):
