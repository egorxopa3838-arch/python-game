        print("0 - Назад")
        try:
            выбор = int(input("Кого купить? "))
            if выбор == 0:
                pass
            elif 1 <= выбор <= len(список_сек):
                имя = список_сек[выбор - 1]
                if секретные_питомцы[имя]["куплен"]:
