магазин_престижа = {
    "Сильная кирка":    {"цена": 100, "бонус": 0.20, "описание": "+20% к добыче"},
    "Глубокие шахты":   {"цена": 150, "бонус": 0.15, "описание": "+15% к добыче"},
    "Удачливый Филя":   {"цена": 200, "бонус": 0.25, "описание": "+25% к добыче"},
    "Золотые руки":     {"цена": 300, "бонус": 0.40, "описание": "+40% к добыче"},
    "Благословение":    {"цена": 500, "бонус": 0.75, "описание": "+75% к добыче"},
}
престиж_куплено = {k: False for k in магазин_престижа}

def копать(помощник=False, тихо=False):
    global деньги, всего_алмазов, всего_накопал, золотая_жила

    множитель = 1.0
    множитель += кирка * 0.1
    множитель += глубина * 0.05
    множитель += престиж * 0.25
    множитель += звёзды * 1.0          # ← +100% за звезду
    if тариф > 0:
        множитель += тарифы[тариф - 1]["бонус"]
    for п in питомцы.values():
        if п["куплен"]:
            множитель += п["бонус"]
    for п in секретные_питомцы.values():
        if п["куплен"]:
            множитель += п["бонус"]
    for имя, куплено in престиж_куплено.items():
        if куплено:
            множитель += магазин_престижа[имя]["бонус"]
    множитель += локации[локация]["бонус"]
    if зелье_эффект == "x2":
        множитель *= 2
    elif зелье_эффект == "x5":
        множитель *= 5
    elif зелье_эффект == "x10":
        множитель *= 10
    elif зелье_эффект == "x25":
        множитель *= 25

    if золотая_жила:
        множитель *= 10
        золотая_жила = False

    rand = random.uniform(0, 100)
    накоплено = 0
    сумма = 0
    найдено = []

    for имя, руда in руды.items():
        накоплено += руда["шанс"]
        if rand <= накоплено:
            найдено.append(имя)
            сумма = int(руда["цена"] * множитель)
            if имя == "алмаз":
                всего_алмазов += 1
            if имя == "Филя-руда":
                достижения["Филя-руда"] = True
                if not тихо:
                    print("🌟 ТЫ НАШЁЛ ФИЛЯ-РУДУ! 🌟")
            if имя == "Адамантит":
                достижения["Адамантит"] = True
                if not тихо:
                    print("💠 ТЫ НАШЁЛ АДАМАНТИТ! 💠")
            if имя == "Филя-кристалл":
                достижения["Филя-кристалл"] = True
                if not тихо:
                    print("💎💎💎 ФИЛЯ-КРИСТАЛЛ! 💎💎💎")
            break

    if not найдено:
        if not тихо:
            print("💨 Пусто...")
        return 0

    if not тихо:
        if помощник:
            print(f"🐱 Помощник нашёл: {', '.join(найдено)}")
        else:
            print(f"✅ Нашёл: {', '.join(найдено)}")
        print(f"💵 Заработал: {сумма:,} ₽")

    деньги += сумма
    всего_накопал += сумма
    return сумма

def случайное_событие():
    global золотая_жила, скидка_магазин, помощники, всего_алмазов, деньги
    rand = random.randint(1, 100)
    if rand <= 3:
        золотая_жила = True
        print("🌟 ЗОЛОТАЯ ЖИЛА! Следующая раскопка ×10!")
        достижения["Счастливчик"] = True
    elif rand <= 5:
        потеря = int(деньги * 0.1)
        деньги = max(0, деньги - потеря)
        print(f"💥 ОБВАЛ! Потеряно {потеря:,} ₽")
        достижения["Невезучий"] = True
    elif rand <= 6:
        всего_алмазов += 10
        print("💎 КЛАД ФИЛИ! +10 алмазов!")
    elif rand <= 8:
        помощники += 1
        print("🧙 ГНОМ-ПОМОЩНИК! +1 помощник!")
    elif rand <= 9:
        скидка_магазин = True
        print("🛒 МАГАЗИН СКИДОК! Следующая покупка −50%!")

def check_achievements():
    if всего_алмазов >= 1 and not достижения["Первый алмаз"]:
        достижения["Первый алмаз"] = True; print("🏆 Первый алмаз!")
    if всего_алмазов >= 100 and not достижения["100 алмазов"]:
        достижения["100 алмазов"] = True; print("🏆 100 алмазов!")
    if всего_алмазов >= 1000 and not достижения["1000 алмазов"]:
        достижения["1000 алмазов"] = True; print("🏆 1000 алмазов!")
    if деньги >= 1000000 and not достижения["Первый миллион"]:
        достижения["Первый миллион"] = True; print("🏆 Первый миллион!")
    if деньги >= 1000000000 and not достижения["Первый миллиард"]:
        достижения["Первый миллиард"] = True; print("🏆 Первый миллиард!")
    if деньги >= 1000000000000 and not достижения["Триллионер"]:
        достижения["Триллионер"] = True; print("🏆 ТРИЛЛИОНЕР!")
    if помощники >= 36 and not достижения["36 помощников"]:
        достижения["36 помощников"] = True; print("🏆 36 помощников!")
    if кирка >= 20 and not достижения["Кирка 20"]:
        достижения["Кирка 20"] = True; print("🏆 Кирка 20!")
    if глубина >= 10 and not достижения["Глубина 10"]:
        достижения["Глубина 10"] = True; print("🏆 Глубина 10!")
    if престиж >= 1 and not достижения["Престиж 1"]:
        достижения["Престиж 1"] = True; print("🏆 Престиж 1!")
    if престиж >= 5 and not достижения["Престиж 5"]:
        достижения["Престиж 5"] = True; print("🏆 Престиж 5!")
    if any(п["куплен"] for п in питомцы.values()) and not достижения["Питомец"]:
        достижения["Питомец"] = True; print("🏆 Первый питомец!")
    if all(п["куплен"] for п in питомцы.values()) and not достижения["Зоопарк"]:
        достижения["Зоопарк"] = True; print("🏆 ЗООПАРК!")
    if 5 in боссы_побеждены and not достижения["Босс 1"]:
        достижения["Босс 1"] = True; print("🏆 Босс 1 побеждён!")
    if 10 in боссы_побеждены and not достижения["Босс 2"]:
        достижения["Босс 2"] = True; print("🏆 Босс 2 побеждён!")
    if 15 in боссы_побеждены and not достижения["Босс 3"]:
        достижения["Босс 3"] = True; print("🏆 Босс 3 побеждён!")
    if 20 in боссы_побеждены and not достижения["Босс 4"]:
        достижения["Босс 4"] = True; print("🏆 Босс 4 побеждён!")
    if 25 in боссы_побеждены and not достижения["Босс 5"]:
        достижения["Босс 5"] = True; print("🏆 Босс 5 побеждён!")
    if 30 in боссы_побеждены and not достижения["Босс 6"]:
        достижения["Босс 6"] = True; print("🏆 Босс 6 побеждён!")
    if any(о["куплено"] for о in оружие.values() if о["цена"] > 0) and not достижения["Оружие"]:
        достижения["Оружие"] = True; print("🏆 Первое оружие!")
    if any(л["открыта"] for л in локации.values() if л["цена"] > 0) and not достижения["Новая локация"]:
        достижения["Новая локация"] = True; print("🏆 Новая локация!")
    if секретные_питомцы["Кот-космонавт"]["куплен"] and not достижения["Кот-космонавт"]:
        достижения["Кот-космонавт"] = True; print("🏆 КОТ-КОСМОНАВТ!")
    if секретные_питомцы["Филя-бог"]["куплен"] and not достижения["Филя-бог"]:
        достижения["Филя-бог"] = True; print("🏆 ФИЛЯ-БОГ!")
    if множители_урона["Кольцо силы"]["куплено"] and not достижения["Кольцо силы"]:
        достижения["Кольцо силы"] = True; print("🏆 Кольцо силы!")
    if множители_урона["Амулет Фили"]["куплено"] and not достижения["Амулет Фили"]:
        достижения["Амулет Фили"] = True; print("🏆 Амулет Фили!")
    if множители_урона["Корона шахтёра"]["куплено"] and not достижения["Корона шахтёра"]:
        достижения["Корона шахтёра"] = True; print("🏆 Корона шахтёра!")
    if множители_урона["Перстень титана"]["куплено"] and not достижения["Перстень титана"]:
        достижения["Перстень титана"] = True; print("🏆 Перстень титана!")
    if множители_урона["Венец Фили"]["куплено"] and not достижения["Венец Фили"]:
        достижения["Венец Фили"] = True; print("🏆 Венец Фили!")
    if len(боссы_побеждены) >= 6 and not достижения["Убийца боссов"]:
        достижения["Убийца боссов"] = True; print("🏆 УБИЙЦА БОССОВ!")
    if звёзды >= 1 and not достижения["1 звезда"]:
        достижения["1 звезда"] = True; print("🏆 1 ЗВЕЗДА!")
    if звёзды >= 5 and not достижения["5 звёзд"]:
        достижения["5 звёзд"] = True; print("🏆 5 ЗВЁЗД!")
    if звёзды >= 10 and not достижения["10 звёзд"]:
        достижения["10 звёзд"] = True; print("🏆 10 ЗВЁЗД!")

def урон_игрока():
    базовый = кирка * 1000 + помощники * 500 + престиж * 2000
    лучший_меч = 0
    for о in оружие.values():
        if о["куплено"] and о["урон"] > лучший_меч:
            лучший_меч = о["урон"]
    урон = базовый + лучший_меч
    for м in множители_урона.values():
        if м["куплено"]:
            урон *= м["множитель"]
    return урон

def бой_с_боссом(глубина_босса):
    global деньги, всего_алмазов, боссы_побеждены
    if глубина_босса in боссы_побеждены:
        print(f"❌ {боссы[глубина_босса]['имя']} уже побеждён!")
        return
    б = боссы[глубина_босса]
    print(f"\n⚔️ БОЙ С БОССОМ: {б['имя']}!")
    урон = урон_игрока()
    print(f"Твой урон: {урон:,} HP | HP босса: {б['хп']:,}")
    if урон >= б["хп"]:
        print(f"🎉 ПОБЕДА! {б['имя']} побеждён!")
        деньги += б["награда"]
        всего_алмазов += б["алмазы"]
        боссы_побеждены.append(глубина_босса)
        print(f"💰 +{б['награда']:,} ₽ | 💎 +{б['алмазы']} алмазов")
    else:
        print(f"❌ Ты проиграл! Нужно {б['хп'] - урон:,} HP ещё")

# === ПРЕСТИЖ 2.0 ===
def престиж_2_0():
    global деньги, кирка, помощники, глубина, престиж, звёзды
    global локация, зелье_эффект, зелье_ходов, боссы_побеждены
    цена = 100000000000 * (звёзды + 1)
    if престиж < 5:
        print(f"❌ Нужно 5 престижей! У тебя {престиж}/5")
        return
    if деньги < цена:
        print(f"❌ Не хватает {цена - деньги:,} ₽")
        return

    деньги = 0
    кирка = 1
    помощники = 0
    глубина = 1
    престиж = 0
    локация = "Обычная шахта"
    зелье_эффект = None
    зелье_ходов = 0
    боссы_побеждены.clear()
    for п in питомцы.values(): п["куплен"] = False
    for п in секретные_питомцы.values(): п["куплен"] = False
    for о in оружие.values():
        if о["цена"] > 0: о["куплено"] = False
    for м in множители_урона.values(): м["куплено"] = False
    for л in локации.values():
        if л["цена"] > 0: л["открыта"] = False
    for k in престиж_куплено: престиж_куплено[k] = False

    звёзды += 1
    save_game()
    print(f"\n🌟 ПРЕСТИЖ 2.0! 🌟")
    print(f"Ты получил {звёзды} ⭐ (+{звёзды * 100}% к добыче!)")
    print("Всё сброшено, кроме звёзд, алмазов и достижений.")

print("=" * 40)
print("   🐱 ФИЛЯ В ШАХТЕ v13.0")
print("=" * 40)

load_game()

def показать_меню():
    print(f"\n💰 Деньги: {деньги:,} ₽")
    print(f"⛏️ Кирка: {кирка} | 💎 Алмазы: {всего_алмазов} | 🏆 Рекорд: {рекорд:,} ₽")
    print(f"🐱 Помощники: {помощники} | 🏔️ Глубина: {глубина} | ⚡ Скорость: x{скорость}")
    print(f"🌟 Престиж: {престиж} (+{престиж*25}%) | ⭐ Звёзды: {звёзды} (+{звёзды*100}%)")
    print(f"🗺️ Локация: {локация}")
    if зелье_эффект:
        print(f"🧪 Зелье: {зелье_эффект} ({зелье_ходов} ходов)")
    if тариф > 0:
        print(f"📱 Тариф: {тарифы[тариф-1]['name']}")
    if авто:
        print("⚡ Автокопание: ВКЛ")
    куплено = sum(1 for п in питомцы.values() if п["куплен"])
    сек_куплено = sum(1 for п in секретные_питомцы.values() if п["куплен"])
    print(f"🐾 Питомцы: {куплено}/{len(питомцы)} | 🚀 Секретные: {сек_куплено}/{len(секретные_питомцы)}")
    print(f"⚔️ Урон: {урон_игрока():,}")
    print("─" * 30)
    print("1-копать 2-зарплата 3-магазин 4-авто 5-рекорд")
    print("6-помощник 7-сохранить 8-выход 9-глубина 10-тарифы")
    print("11-достижения 12-сброс 13-статистика 14-престиж")
    print("15-редактор 16-питомцы 17-магазин престижа 18-боссы")
    print("19-вызов босса 20-оружие 21-зелья 22-локации")
    print("23-магазин алмазов 24-секретные питомцы 25-множители урона")
    print("26-🌟 ПРЕСТИЖ 2.0")

while True:
    показать_меню()
    cmd = input("Что делать? ")

    if cmd == "1":
        print("⭕️⛏️🐈‍⬛ Филя копает...")
        time.sleep(0.3)
        копать()
        if random.randint(1, 100) <= 10:
            случайное_событие()

    elif cmd == "2":
        сумма_зарплаты = random.randint(5000, 35000)
        сумма_зарплаты += помощники * 1000
        сумма_зарплаты += глубина * 500
        сумма_зарплаты += int(сумма_зарплаты * звёзды * 1.0)   # ← бонус от звёзд

        rand = random.randint(1, 100)
        if rand <= 1:
            сумма_зарплаты *= 3
            print("💎💎💎 ТРОЙНАЯ ЗАРПЛАТА!!! 💎💎💎")
        elif rand <= 11:
            сумма_зарплаты *= 2
            print("🎉 ДВОЙНАЯ ЗАРПЛАТА!")

        деньги += сумма_зарплаты
        всего_накопал += сумма_зарплаты
        print(f"🗃👨‍💼 Менеджер дал {сумма_зарплаты:,} ₽")

    elif cmd == "3":
        print("\n🏪 МАГАЗИН")
        цена_кирки = 10000 * кирка
        цена_скорости = 200000 * скорость
        if скидка_магазин:
            цена_кирки //= 2
            цена_скорости //= 2
            print("🛒 СКИДКА −50%!")
        print(f"1 - Кирка ({кирка}→{кирка+1}) — {цена_кирки:,} ₽")
        print(f"2 - Скорость (x{скорость}→x{скорость+1}) — {цена_скорости:,} ₽")
        print("3 - Назад")
        shop = input("Что купить? ")
        if shop == "1":
            if деньги >= цена_кирки:
                деньги -= цена_кирки; кирка += 1
                print(f"✅ Кирка: {кирка}")
                скидка_магазин = False
            else:
                print(f"❌ Не хватает {цена_кирки - деньги:,} ₽")
        elif shop == "2":
            if деньги >= цена_скорости:
                деньги -= цена_скорости; скорость += 1
                print(f"✅ Скорость: x{скорость}")
                скидка_магазин = False
            else:
                print(f"❌ Не хватает {цена_скорости - деньги:,} ₽")

    elif cmd == "4":
        if авто:
            print("⚡ Уже включено")
        elif деньги >= 100000:
            деньги -= 100000; авто = True
            print("⚡ Автокопание ВКЛ!")
        else:
            print("❌ Нужно 100000 ₽")

    elif cmd == "5":
        if деньги > рекорд:
            рекорд = деньги
            print(f"🏆 Новый рекорд: {рекорд:,} ₽!")
        else:
            print(f"🏆 Рекорд: {рекорд:,} ₽")

    elif cmd == "6":
        цена = 50000 * (помощники + 1)
        if деньги >= цена:
            деньги -= цена; помощники += 1
            print(f"🐱 Помощник: {помощники}")
        else:
            print(f"❌ Нужно {цена:,} ₽")

    elif cmd == "7":
        save_game()
        print("💾 Сохранено!")

    elif cmd == "8":
        save_game()
        print(f"\n🐱 Филя заработал: {деньги:,} ₽")
        break

    elif cmd == "9":
        print(f"\n🏔️ ГЛУБИНА: {глубина}")
        цена = 100000 * (глубина ** 2)
        print(f"Углубиться → {глубина+1} — {цена:,} ₽")
        новая_глубина = глубина + 1
        if новая_глубина in боссы and новая_глубина not in боссы_побеждены:
            б = боссы[новая_глубина]
            print(f"⚠️ НА ПУТИ БОСС: {б['имя']}!")
        print("1-углубиться 2-назад")
        if input() == "1":
            if деньги >= цена:
                деньги -= цена
                глубина += 1
                print(f"✅ Глубина: {глубина}")
                if глубина in боссы and глубина not in боссы_побеждены:
                    бой_с_боссом(глубина)
            else:
                print(f"❌ Не хватает {цена - деньги:,} ₽")

    elif cmd == "10":
        print("\n📱 ТАРИФЫ")
        for i, t in enumerate(тарифы, 1):
            статус = "✅" if тариф == i else "  "
            print(f"{статус} {i}. {t['name']}: {t['гб']}ГБ — {t['мес']}₽ (+{int(t['бонус']*100)}%)")
        print("0-отключить 1-подключить")
        выбор = input("Что? ")
        if выбор == "1":
            num = int(input("Номер тарифа: "))
            if 1 <= num <= len(тарифы):
                тариф = num
                print(f"✅ {тарифы[num-1]['name']}!")
        elif выбор == "0":
            тариф = 0
            print("❌ Отключён")

    elif cmd == "11":
        print("\n🏆 ДОСТИЖЕНИЯ")
        for name, done in достижения.items():
            print(f"{'✅' if done else '⬜'} {name}")

    elif cmd == "12":
        if input("⚠️ Сбросить? 1-да 2-нет: ") == "1":
            деньги=0; кирка=1; всего_алмазов=0; рекорд=0
            авто=False; помощники=0; глубина=1; тариф=0
            скорость=1; престиж=0; всего_накопал=0; звёзды=0
            боссы_побеждены.clear()
            локация = "Обычная шахта"
            зелье_эффект = None; зелье_ходов = 0
            for п in питомцы.values(): п["куплен"] = False
            for k in престиж_куплено: престиж_куплено[k] = False
            for о in оружие.values():
                if о["цена"] > 0: о["куплено"] = False
            for л in локации.values():
                if л["цена"] > 0: л["открыта"] = False
            for п in секретные_питомцы.values(): п["куплен"] = False
            for м in множители_урона.values(): м["куплено"] = False
            save_game()
            print("🔄 Сброшено!")

    elif cmd == "13":
        print("\n📊 СТАТИСТИКА")
        print(f"Всего накопал: {всего_накопал:,} ₽")
        print(f"Алмазов: {всего_алмазов}")
        print(f"Урон: {урон_игрока():,} HP")
        print(f"Звёзд: {звёзды} ⭐ (+{звёзды * 100}%)")
        м = 1.0 + кирка*0.1 + глубина*0.05 + престиж*0.25 + звёзды*1.0
        if тариф > 0: м += тарифы[тариф-1]["бонус"]
        for п in питомцы.values():
            if п["куплен"]: м += п["бонус"]
        for п in секретные_питомцы.values():
            if п["куплен"]: м += п["бонус"]
        for имя, куплено in престиж_куплено.items():
            if куплено: м += магазин_престижа[имя]["бонус"]
        м += локации[локация]["бонус"]
        print(f"Множитель добычи: ×{м:.2f}")

    elif cmd == "14":
        print(f"\n🌟 ПРЕСТИЖ: {престиж} (+{престиж*25}%)")
        цена = 1000000000 * (престиж + 1)
        print(f"Цена: {цена:,} ₽")
        print("1-сделать 2-назад")
        if input() == "1":
            if деньги >= цена:
                деньги=0; кирка=1; помощники=0
                глубина=1; тариф=0; авто=False
                престиж += 1
                save_game()
                print(f"🌟 +{престиж*25}%!")
            else:
                print(f"❌ Не хватает {цена - деньги:,} ₽")

    elif cmd == "15":
        print("\n⚙️ РЕДАКТОР")
        for i, (имя, руда) in enumerate(руды.items(), 1):
            print(f"{i}. {имя}: {руда['цена']} ₽ ({руда['шанс']}%)")
        print("q-назад")
        choice = input("Что? ")
        if choice != "q":
            try:
                num = int(choice)
                имя = list(руды.keys())[num - 1]
                print("1-цена 2-шанс")
                edit = input()
                if edit == "1":
                    руды[имя]["цена"] = int(input("Новая цена: "))
                elif edit == "2":
                    руды[имя]["шанс"] = float(input("Новый шанс: "))
                print("✅")
            except:
                print("❌")

    elif cmd == "16":
        print("\n🐾 ПИТОМЦЫ")
        список_питомцев = list(питомцы.keys())
        for i, имя in enumerate(список_питомцев, 1):
            п = питомцы[имя]
            статус = "✅ Куплен" if п["куплен"] else f"{п['цена']:,} ₽"
            print(f"{i}. {имя}: +{int(п['бонус']*100)}% — {статус} | копает x{п['копает']}")
        print("0 - Назад")
        try:
            выбор = int(input("Кого купить? "))
            if выбор == 0:
                pass
            elif 1 <= выбор <= len(список_питомцев):
                имя = список_питомцев[выбор - 1]
                if питомцы[имя]["куплен"]:
                    print("❌ Уже куплен")
                else:
                    цена = питомцы[имя]["цена"]
                    if скидка_магазин:
                        цена //= 2
                        print(f"🛒 СКИДКА −50%! Цена: {цена:,} ₽")
                    if деньги >= цена:
                        деньги -= цена
                        питомцы[имя]["куплен"] = True
                        скидка_магазин = False
                        print(f"✅ {имя} куплен!")
                    else:
                        print(f"❌ Не хватает {цена - деньги:,} ₽")
            else:
                print("❌ Неверный номер")
        except:
            print("❌ Введи число")

    elif cmd == "17":
        print(f"\n🛒 МАГАЗИН ПРЕСТИЖА (у тебя {всего_алмазов} 💎)")
        список_престижа = list(магазин_престижа.keys())
        for i, имя in enumerate(список_престижа, 1):
            б = магазин_престижа[имя]
            статус = "✅" if престиж_куплено[имя] else f"{б['цена']} 💎"
            print(f"{i}. {имя}: {б['описание']} — {статус}")
        print("0-назад")
        try:
            выбор = int(input("Что купить? "))
            if выбор == 0:
                pass
            elif 1 <= выбор <= len(список_престижа):
                имя = список_престижа[выбор - 1]
                if престиж_куплено[имя]:
                    print("❌ Уже куплено")
                elif всего_алмазов >= магазин_престижа[имя]["цена"]:
                    всего_алмазов -= магазин_престижа[имя]["цена"]
                    престиж_куплено[имя] = True
                    print(f"✅ {имя} куплен!")
                else:
                    print(f"❌ Нужно {магазин_престижа[имя]['цена']} 💎")
            else:
                print("❌ Неверный номер")
        except:
            print("❌ Введи число")

    elif cmd == "18":
        print("\n⚔️ БОССЫ")
        for г, б in боссы.items():
            статус = "✅ Побеждён" if г in боссы_побеждены else "⬜ Не побеждён"
            print(f"Глубина {г}: {б['имя']} (HP {б['хп']:,}) — {статус}")

    elif cmd == "19":
        print("\n⚔️ ВЫЗОВ БОССА")
        for г, б in боссы.items():
            if г not in боссы_побеждены:
                print(f"{г}. {б['имя']} — глубина {г}, HP {б['хп']:,}")
        print("0-назад")
        try:
            выбор = int(input("Кого вызвать? "))
            if выбор == 0:
                pass
            elif выбор in боссы:
                бой_с_боссом(выбор)
            else:
                print("❌ Нет такого босса")
        except:
            print("❌ Введи число")

    elif cmd == "20":
        print(f"\n🗡️ ОРУЖИЕ (твой урон: {урон_игрока():,})")
        список_оружия = list(оружие.keys())
        for i, имя in enumerate(список_оружия, 1):
            о = оружие[имя]
            статус = "✅ Куплено" if о["куплено"] else f"{о['цена']:,} ₽"
            print(f"{i}. {имя}: +{о['урон']:,} урона — {статус}")
        print("0 - Назад")
        try:
            выбор = int(input("Что купить? "))
            if выбор == 0:
                pass
            elif 1 <= выбор <= len(список_оружия):
                имя = список_оружия[выбор - 1]
                if оружие[имя]["куплено"]:
                    print("❌ Уже куплено")
                elif деньги >= оружие[имя]["цена"]:
                    деньги -= оружие[имя]["цена"]
                    оружие[имя]["куплено"] = True
                    print(f"✅ {имя} куплен!")
                else:
                    print(f"❌ Не хватает {оружие[имя]['цена'] - деньги:,} ₽")
            else:
                print("❌ Неверный номер")
        except:
            print("❌ Введи число")

    elif cmd == "21":
        print("\n🧪 ЗЕЛЬЯ")
        список_зелий = list(зелья.keys())
        for i, имя in enumerate(список_зелий, 1):
            з = зелья[имя]
            print(f"{i}. {имя}: {з['эффект']} добыча на {з['ходов']} ходов — {з['цена']:,} ₽")
        print("0 - Назад")
        try:
            выбор = int(input("Что купить? "))
            if выбор == 0:
                pass
            elif 1 <= выбор <= len(список_зелий):
                имя = список_зелий[выбор - 1]
                if деньги >= зелья[имя]["цена"]:
                    деньги -= зелья[имя]["цена"]
                    зелье_эффект = зелья[имя]["эффект"]
                    зелье_ходов = зелья[имя]["ходов"]
                    достижения["Зелье"] = True
                    print(f"✅ {имя} выпито! {зелье_эффект} на {зелье_ходов} ходов")
                else:
                    print(f"❌ Не хватает {зелья[имя]['цена'] - деньги:,} ₽")
            else:
                print("❌ Неверный номер")
        except:
            print("❌ Введи число")

    elif cmd == "22":
        print("\n🗺️ ЛОКАЦИИ")
        список_локаций = list(локации.keys())
        for i, имя in enumerate(список_локаций, 1):
            л = локации[имя]
            статус = "✅ Открыта" if л["открыта"] else f"{л['цена']:,} ₽"
            print(f"{i}. {имя}: +{int(л['бонус']*100)}% — {статус}")
        print("0 - Назад")
        try:
            выбор = int(input("Куда перейти? "))
            if выбор == 0:
                pass
            elif 1 <= выбор <= len(список_локаций):
                имя = список_локаций[выбор - 1]
                if локации[имя]["открыта"]:
                    локация = имя
                    print(f"✅ Перешёл в {имя}!")
                elif деньги >= локации[имя]["цена"]:
                    деньги -= локации[имя]["цена"]
                    локации[имя]["открыта"] = True
                    локация = имя
                    достижения["Новая локация"] = True
                    print(f"✅ {имя} открыта! Перешёл туда!")
                else:
                    print(f"❌ Не хватает {локации[имя]['цена'] - деньги:,} ₽")
            else:
                print("❌ Неверный номер")
        except:
            print("❌ Введи число")

    elif cmd == "23":
        print(f"\n💎 МАГАЗИН АЛМАЗОВ (у тебя {всего_алмазов} 💎)")
        for i, (номер, пакет) in enumerate(магазин_алмазов.items(), 1):
            print(f"{номер}. {пакет['алмазов']:,} 💎 — {пакет['цена']:,} ₽")
        print("0 - Назад")
        try:
            выбор = int(input("Что купить? "))
            if выбор == 0:
                pass
            elif выбор in магазин_алмазов:
                пакет = магазин_алмазов[выбор]
                if деньги >= пакет["цена"]:
                    деньги -= пакет["цена"]
                    всего_алмазов += пакет["алмазов"]
                    print(f"✅ +{пакет['алмазов']:,} 💎! Теперь у тебя {всего_алмазов} алмазов")
                else:
                    print(f"❌ Не хватает {пакет['цена'] - деньги:,} ₽")
            else:
                print("❌ Неверный номер")
        except:
            print("❌ Введи число")

    elif cmd == "24":
        print("\n🚀 СЕКРЕТНЫЕ ПИТОМЦЫ")
        список_сек = list(секретные_питомцы.keys())
